rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuário só acessa o próprio documento.
    match /painel/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // Nada mais é acessível.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// TRAVA EXTRA (recomendada, já que é um app de uma pessoa só):
// depois de logar a primeira vez, copie seu UID no console do Firebase
// (Authentication > Users) e troque a regra acima por esta, que permite
// apenas você — mesmo que alguém descubra a URL e o apiKey:
//
//     match /painel/{uid} {
//       allow read, write: if request.auth != null
//                          && request.auth.uid == uid
//                          && uid == 'COLE_SEU_UID_AQUI';
//     }
