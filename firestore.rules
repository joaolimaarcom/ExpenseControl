rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // O app novo guarda tudo em contas/{uid}.
    match /contas/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // Coleção do app antigo. Fica liberada só para você conseguir
    // consultar ou baixar o que ficou lá; o app novo não escreve nela.
    // Pode apagar este bloco quando não precisar mais dos dados velhos.
    match /painel/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // Nada mais é acessível.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// TRAVA EXTRA (recomendada, já que é um app de uma pessoa só):
// depois de logar a primeira vez, copie seu UID no console do Firebase
// (Authentication > Users) e acrescente a comparação abaixo, que permite
// apenas você — mesmo que alguém descubra a URL e o apiKey:
//
//     match /contas/{uid} {
//       allow read, write: if request.auth != null
//                          && request.auth.uid == uid
//                          && uid == 'COLE_SEU_UID_AQUI';
//     }
